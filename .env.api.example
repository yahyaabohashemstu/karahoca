# ═══════════════════════════════════════════════════════════════════════════
# KARAHOCA backend env template (Dockerfile — Node.js API only)
# ─────────────────────────────────────────────────────────────────────────
# Read at runtime by server-bootstrap.mjs. In Coolify: pass these as
# **Runtime** variables on the karahoca-api service. Nothing here is baked
# into the image, so changing a value just requires a restart.
#
# NOTE: every VITE_* variable belongs in .env.web.example, not here. The
# API never reads VITE_* and the frontend never reads anything else.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Runtime basics ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Stamped onto /api/health responses + Sentry events. Pass git short SHA
# from CI (or leave empty in dev).
APP_VERSION=
GIT_COMMIT=

# ─── CORS allowlist (REQUIRED) ──────────────────────────────────────────────
# Now that the SPA lives on a different host than the API, the API must
# explicitly trust the SPA's origin or every credentialed fetch will be
# blocked by the browser. ALLOWED_ORIGINS accepts a comma-separated list;
# SITE_URL / FRONTEND_URL are added implicitly.
ALLOWED_ORIGINS=https://karahoca.com
FRONTEND_URL=https://karahoca.com
SITE_URL=https://karahoca.com

# Public URL of THIS service — used to build absolute image links inside
# email campaigns. Should be the karahoca-api domain. If unset, falls back
# to SITE_URL (which would point at nginx, where /api/uploads/* 404s).
API_PUBLIC_URL=https://api.karahoca.com

# ─── Admin authentication ───────────────────────────────────────────────────
# JWT_SECRET — sign secret for admin auth tokens. CHANGE THIS in prod.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Admin login. ADMIN_PASSWORD_HASH is bcrypt — NEVER store the plaintext.
# Generate the hash:
#   node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ─── Newsletter unsubscribe tokens (optional) ───────────────────────────────
# Defaults to JWT_SECRET when empty; set explicitly if you want unsubscribe
# links to keep working after a JWT_SECRET rotation.
NEWSLETTER_TOKEN_SECRET=
# How long an unsubscribe link stays valid (seconds). Default: 1 year.
NEWSLETTER_UNSUBSCRIBE_TOKEN_TTL_SEC=31536000

# ─── AI chat (REQUIRED for the /api/ai/chat widget) ─────────────────────────
# OpenRouter key — server-side only (NEVER expose via VITE_*).
# Used by aiChat.mjs (public widget) and admin-translate.mjs (auto-translate).
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# ─── Email campaigns (Resend.com — free 100/day, 3000/month) ────────────────
# Get a key at https://resend.com. FROM_EMAIL must be on a verified domain.
RESEND_API_KEY=
FROM_EMAIL=KARAHOCA <noreply@karahoca.com>

# Override only if email images should load from a CDN. Otherwise the API
# uses API_PUBLIC_URL above.
EMAIL_ASSETS_BASE_URL=

# ─── Redis (optional — rate limiting + queues) ──────────────────────────────
# Without REDIS_URL the API runs in single-instance memory mode, which is
# fine for a single Coolify replica. Set this when scaling horizontally.
REDIS_URL=

# ─── Hardening (optional) ───────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000

# ─── GA4 Data API (admin dashboard charts) ──────────────────────────────────
# Without these, the analytics page renders setup instructions instead.
# Steps:
#   1. Google Cloud Console → IAM & Admin → Service Accounts → Create
#   2. Download the JSON key file
#   3. GA4 Admin → Property Access Management → add the service account email as Viewer
#   4. Google Cloud Console → APIs & Services → Library → enable "Google Analytics Data API"
#   5. Paste the entire JSON contents below as a single line
#   6. GA_PROPERTY_ID: just the number (e.g. 123456789), NOT "properties/123456789"
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=

# ─── Cloud Backup (optional — Cloudflare R2 / AWS S3 / any S3-compatible) ───
# Leave S3_BUCKET_NAME / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty to
# keep local-only 7-copy rotation in server/data/backups/. When all three
# are set, each daily backup uploads to S3 and prunes old objects to
# MAX_CLOUD_BACKUPS.
#
# Provider examples:
#   Cloudflare R2:           S3_ENDPOINT=https://<acct>.r2.cloudflarestorage.com  S3_REGION=auto
#   AWS S3:                  S3_ENDPOINT=(empty)                                  S3_REGION=us-east-1
#   DigitalOcean Spaces:     S3_ENDPOINT=https://<rgn>.digitaloceanspaces.com     S3_REGION=us-east-1
#   MinIO (self-hosted):     S3_ENDPOINT=https://minio.example.com  S3_REGION=us-east-1  S3_FORCE_PATH_STYLE=true
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=auto
S3_KEY_PREFIX=backups/karahoca/
S3_FORCE_PATH_STYLE=

# Same credentials work for every S3-compatible provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Older backups beyond this count are pruned from S3. Local retention stays
# fixed at 7 via the fallback code path.
MAX_CLOUD_BACKUPS=30

# ─── Sentry telemetry (optional) ────────────────────────────────────────────
# Server-side SDK loads only when DSN is set, so leaving these empty is a
# zero-cost no-op. Sample rates are floats 0.0–1.0.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
