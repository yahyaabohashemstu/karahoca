# Google Analytics Configuration
# احصل على معرف GA4 من: https://analytics.google.com/
# شكل المعرف: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Frontend API base URL
# اتركه فارغاً إذا كانت الواجهة والـ API على نفس النطاق العام.
# للتطوير المحلي فقط، يمكنك إلغاء تعليق السطر التالي:
# VITE_BACKEND_URL=http://localhost:5000
VITE_BACKEND_URL=

# Backend CORS allowlist
# افصل النطاقات الإضافية بفواصل عند الحاجة.
# SITE_URL و FRONTEND_URL يُضافان تلقائياً إلى allowlist في الخادم.
# إذا كانت الواجهة والـ API على نفس النطاق، يمكن ترك ALLOWED_ORIGINS فارغاً.
ALLOWED_ORIGINS=
FRONTEND_URL=
# Server-side Gemini API key
# يُستخدم فقط من الخادم المحلي / server/server.mjs
GEMINI_API_KEY=put_server_side_key_here

# PostgreSQL connection string for admin panel and chat persistence
# Example: postgres://user:password@localhost:5432/karahoca
DATABASE_URL=

# Admin authentication
# JWT_SECRET — مفتاح JWT لتوقيع التوكنات (يجب تغييره في بيئة الإنتاج)
JWT_SECRET=change_me_to_a_long_random_secret
# ADMIN_USERNAME — اسم المستخدم لتسجيل دخول الأدمن (الافتراضي: admin)
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH — bcrypt hash لكلمة السر (ليس النص العادي!)
# أنشئ الهاش بأمر: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=

# Optional hardening
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000

# ─── Google Analytics 4 — Data API (for admin dashboard) ─────────────────────
# بدون هذين المتغيرين ستظهر تعليمات الإعداد في صفحة التحليلات
#
# الخطوات:
#   1. Google Cloud Console → IAM & Admin → Service Accounts → أنشئ حساباً جديداً
#   2. نزّل ملف JSON لمفاتيح الحساب
#   3. GA4 Admin → Property Access Management → أضف البريد الإلكتروني للحساب كـ Viewer
#   4. Google Cloud Console → APIs & Services → Library → فعّل "Google Analytics Data API"
#   5. انسخ محتوى ملف JSON كاملاً في السطر أدناه (سطر واحد)
#   6. GA_PROPERTY_ID: الرقم فقط من GA4 Admin → Property Settings (مثال: 123456789)

GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=

# ─── Email Campaigns (Resend.com — free: 100/day, 3000/month) ─────────────────
# احصل على مفتاح مجاني من: https://resend.com
# FROM_EMAIL يجب أن يكون من نطاق مؤكّد في Resend
RESEND_API_KEY=
FROM_EMAIL=KARAHOCA <noreply@karahoca.com>
SITE_URL=https://karahoca.com

# Public URL of the Node.js API backend (used to build absolute image URLs in emails).
# In Coolify: set this to the public domain of your "Abo-Hashem" Node.js service.
# Example: https://api.karahoca.com  or  https://abo-hashem.YOUR-COOLIFY-DOMAIN.coolify.io
# If left empty, falls back to SITE_URL (which will cause broken images when
# nginx and the API run as separate containers, since nginx does not proxy /api/).
API_PUBLIC_URL=

# ─── Cloud Backup (Cloudflare R2 / AWS S3 / any S3-compatible) ───────────────
# اتركها فارغة لتفعيل النسخ المحلي فقط (7 نسخ في server/data/backups/)
# مع الإعداد: يُرفع ملف مضغوط يومياً إلى السحابة مع الاحتفاظ بآخر 30 نسخة
#
# Cloudflare R2:
#   BACKUP_S3_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   BACKUP_S3_REGION   = auto
# AWS S3:
#   BACKUP_S3_ENDPOINT = https://s3.<region>.amazonaws.com
#   BACKUP_S3_REGION   = us-east-1  (or your bucket's region)

# ─── Phase 6.2 env names (the server reads THESE) ─────────────────────────
# Leave ALL of S3_BUCKET_NAME / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty
# to keep the local-only 7-copy rotation (default, zero-config).
#
# When all three are set, each backup run:
#   1. Takes a consistent snapshot via better-sqlite3 .backup()
#   2. Uploads the .db file to S3 with server-side encryption (where supported)
#   3. Deletes the local temp file so disk usage stays flat
#   4. Prunes older S3 objects down to MAX_CLOUD_BACKUPS (default 30)
# If step 2 fails, the local snapshot is retained as a fallback.
#
# Provider examples:
#   Cloudflare R2:           S3_ENDPOINT=https://<acct>.r2.cloudflarestorage.com  S3_REGION=auto
#   AWS S3:                  S3_ENDPOINT=(empty)                                  S3_REGION=us-east-1
#   DigitalOcean Spaces:     S3_ENDPOINT=https://<rgn>.digitaloceanspaces.com     S3_REGION=us-east-1
#   MinIO (self-hosted):     S3_ENDPOINT=https://minio.example.com  S3_REGION=us-east-1  S3_FORCE_PATH_STYLE=true
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=auto
S3_KEY_PREFIX=backups/karahoca/
S3_FORCE_PATH_STYLE=

# Credentials — AWS-standard names. Same pair works for every S3-compatible
# provider (R2 tokens, DO Spaces keys, AWS IAM keys, MinIO keys).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Retention cap for S3 objects (older backups are pruned). Local retention
# stays fixed at 7 via the fallback code path.
MAX_CLOUD_BACKUPS=30

# ─── LEGACY (pre-6.2) — kept for reference during rollout, not read ────────
# Old code used BACKUP_S3_* names. The new backup.mjs reads the names above
# instead. These lines exist so operators upgrading in-place notice the
# rename and migrate.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=karahoca-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto

